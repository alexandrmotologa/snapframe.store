FIGMA_TOKEN=

# Firebase Client Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin Service Account (Server-side)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI Superpowers Provider API Keys (Add any or all of these)
# Priority 1: Gemini (Multimodal Vision & Fast Text Generation)
GEMINI_API_KEY=

# Priority 2: OpenAI (GPT-4o-mini Copywriting & ASO)
OPENAI_API_KEY=

# Priority 3: Groq (Llama 3.3 70B Ultra-fast Text & ASO)
GROQ_API_KEY=

# Priority 4: Mistral (Mistral Small / Pixtral Vision)
MISTRAL_API_KEY=

# Priority 5: xAI Grok (Grok 2 / Grok 2 Vision)
XAI_API_KEY=

# ==============================================================================
# Paddle Billing Configuration (v2)
# ==============================================================================
# Active Environment ("sandbox" or "production").
# Auto-detects "sandbox" on develop.snapframe.store / localhost / vercel previews.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client-Side Token (from Paddle Dashboard -> Developer tools -> Authentication)
# Sandbox: "test_..." | Production: "live_..."
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_0123456789abcdef

# Product Price IDs (from Paddle Dashboard -> Catalog -> Prices)
# Monthly Plan ($9 / month)
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=pri_0123456789abcdef
# Annual Plan ($69 / year)
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=pri_0123456789abcdef

# Server-Side Webhook Secret Key (from Paddle Dashboard -> Notifications -> Webhooks)
# Used to verify HMAC signature on /api/webhooks/paddle
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntf_set_0123456789abcdef

# Optional: Dedicated Sandbox Webhook Secret (if testing both simultaneously)
# PADDLE_SANDBOX_WEBHOOK_SECRET_KEY=pdl_ntf_set_...

